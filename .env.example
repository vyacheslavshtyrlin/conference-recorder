# Recording-bot process
NODE_ENV=production
RECORDING_BOT_BIND_HOST=0.0.0.0
RECORDING_BOT_PORT=8090
RECORDING_BOT_PUBLIC_ORIGIN=http://10.0.0.12:8090
# Host interface that exposes bot control only to the private network.
RECORDING_BOT_BIND_ADDR=10.0.0.12

# One slot records one room. Increase only together with measured CPU/RAM capacity.
RECORDING_BOT_MAX_SLOTS=1
RECORDING_BOT_WORKER_ID=recording-worker-local-1
RECORDING_BOT_ENABLE_VERIFICATION=false
RECORDING_BOT_START_TIMEOUT_MS=30000
RECORDING_BOT_STOP_TIMEOUT_MS=10000
RECORDING_BOT_RECOVERY_TIMEOUT_MS=30000

# Private API endpoint and independent worker credentials.
RECORDING_API_INTERNAL_URL=http://10.0.0.10:3000
RECORDING_CAPTURE_SERVICE_SECRET=replace-with-at-least-32-random-characters
RECORDING_COMPOSITION_SERVICE_SECRET=replace-with-at-least-32-random-characters
# Private mounted storage and bounded FFmpeg finalization
RECORDING_STORAGE_ROOT=/var/lib/conference-recording
RECORDING_FFMPEG_TIMEOUT_MS=120000
RECORDING_FINALIZE_MAX_ATTEMPTS=3
RECORDING_FINALIZE_RETRY_DELAY_MS=250
RECORDING_MAX_SOURCE_BYTES=4000000000
RECORDING_MAX_DURATION_SECONDS=14400

# Signaling-to-bot control JWT. Replace the secret in every non-local environment.
RECORDING_BOT_CONTROL_JWT_HS256_SECRET=replace-with-at-least-32-random-characters

# Optional binary overrides. The Docker image already supplies these binaries.
# CHROMIUM_EXECUTABLE_PATH=/path/to/chromium
# RECORDING_FFMPEG_PATH=/path/to/ffmpeg
# RECORDING_FFPROBE_PATH=/path/to/ffprobe
