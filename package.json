{
  "name": "@conference/recording-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && esbuild src/browser.ts --bundle --format=esm --platform=browser --target=chrome120 --outfile=dist/public/browser.js && esbuild src/e2ePublisher.ts --bundle --format=esm --platform=browser --target=chrome120 --outfile=dist/public/e2ePublisher.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "start:composition": "node dist/composition.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "mediasoup-client": "3.18.2",
    "playwright-core": "1.55.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@types/node": "22.15.30",
    "esbuild": "0.25.6",
    "eslint": "9.31.0",
    "globals": "16.3.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.37.0",
    "vitest": "2.1.9"
  }
}
